# ============================================
# MySQL Database Configuration
# ============================================
# MySQL root password â€“ Set this to your actual root password
MYSQL_ROOT_PASSWORD=abhinav!@nag9454

# Database name (must match docker-compose default)
MYSQL_DATABASE=face-student

# MySQL application username (must match docker-compose default)
MYSQL_USER=student-face

# MySQL application user password â€“ Must match the password in docker-compose
MYSQL_PASSWORD=abhinav!@nag9454
MYSQL_PORT=3307

# ============================================
# Backend Database Connection (Spring Boot)
# ============================================
# Database URL â€“ useSSL=false matches docker-compose default
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/face-student?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Show SQL logs? (true/false)
SPRING_JPA_SHOW_SQL=false

# ============================================
# Backend Security Configuration
# ============================================
# JWT secret key â€“ Change to a long random string (minimum 32 chars)
JWT_SECRET=change-this-to-a-long-random-secret-key-with-32-chars-plus

# JWT access token expiry (milliseconds) â€“ 15 minutes
JWT_ACCESS_EXPIRATION_MS=900000

# AI API key â€“ Must match between backend and ai-service
AI_API_KEY=change-this-to-a-long-random-ai-api-key

# Require HTTPS in production? (false for development)
APP_SECURITY_REQUIRE_HTTPS=false

# Use secure cookies? (false for HTTP, true for HTTPS)
APP_SECURITY_SECURE_COOKIES=false

# BCrypt strength (higher = slower but more secure)
APP_SECURITY_BCRYPT_STRENGTH=12

# Refresh token expiry (14 days)
APP_SECURITY_REFRESH_TOKEN_TTL_MS=1209600000

# Access token expiry (15 minutes)
APP_SECURITY_ACCESS_TOKEN_TTL_MS=900000

# Rate limit â€“ max login attempts per minute per IP
APP_RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=5

# ============================================
# Notification Settings (Email/SMS)
# ============================================
# Enable notifications globally
NOTIFICATIONS_ENABLED=true

# Enable email notifications
NOTIFICATIONS_EMAIL_ENABLED=false

# From email address for notifications
NOTIFICATIONS_EMAIL_FROM=no-reply@face-detection.local

# Enable SMS notifications (requires Twilio)
NOTIFICATIONS_SMS_ENABLED=false

# Twilio credentials (fill if SMS enabled)
NOTIFICATIONS_TWILIO_ACCOUNT_SID=
NOTIFICATIONS_TWILIO_AUTH_TOKEN=
NOTIFICATIONS_TWILIO_FROM_NUMBER=

# ============================================
# Frontend Configuration
# ============================================
# CORS allowed origin for backend
FRONTEND_ORIGIN=http://localhost:3000

# API base URL for frontend (for axios)
VITE_API_BASE_URL=http://localhost:8080

# AI stream URL for frontend
VITE_AI_STREAM_BASE_URL=http://localhost:5000

# Enable live feed UI on dashboard (true/false)
VITE_ENABLE_LIVE_FEED=true

# ============================================
# AI Service Configuration
# ============================================
# Backend internal URL (Docker network)
BACKEND_URL=http://backend:8080

# Verify SSL for backend? (false for self-signed/dev)
BACKEND_VERIFY_SSL=false

# Camera ID (leave blank to avoid forcing local webcam on startup)
CAMERA_ID=

# Multiple camera sources (comma-separated): e.g. 0,1,rtsp://192.168.1.50:554/stream
# If set, this overrides single CAMERA_ID for ai-service.
CAMERA_IDS=

# Attendance interval (seconds) â€“ how often to send batch
ATTENDANCE_INTERVAL=300

# Face recognition confidence threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.6

# Enable AI live stream and admin camera manager endpoints
LIVE_STREAM_ENABLED=true

# Live stream FPS (lower = less CPU/network load)
STREAM_FPS=8

# AI processing loop delay in milliseconds (higher = less CPU load, slower recognition)
PROCESSING_LOOP_DELAY_MS=80

# Offline sync interval (seconds) â€“ how often to retry sending when offline
OFFLINE_SYNC_INTERVAL=120

